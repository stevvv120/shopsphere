DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shopsphere?schema=public"
HOST=127.0.0.1
PORT=3001
# Flat shipping fee in rupiah for every address; 0 means free shipping.
SHIPPING_FEE=0
# Public payment instructions shown to customers. Set all three, or leave all blank.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set a random secret with at least 32 bytes before starting the API.
JWT_SECRET=

# Set these before running npm run admin:seed.
ADMIN_NAME=ShopSphere Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Jumlah reverse proxy di depan API (mis. 1 untuk Nginx). Kosongkan jika API diakses langsung.
TRUST_PROXY=